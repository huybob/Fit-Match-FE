NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
# Bug 8 (dev): hien nut "Mo phong thanh toan" trong dialog VietQR (BE can profile local/dev)
NEXT_PUBLIC_DEV_PAYMENT=1
# UC-18: key Maps JavaScript API (browser) cho ban do + Places Autocomplete o trang
# /gyms. Bat "Maps JavaScript API" va "Places API" trong Google Cloud Console, roi
# gioi han key theo HTTP referrer. De trong = trang tim gym chay o che do danh sach.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# UC-003: OAuth 2.0 Client ID loai "Web application" cho nut "Dang nhap bang Google".
# Phai TRUNG voi GOOGLE_OAUTH_CLIENT_IDS cua BE. Trong Google Cloud Console, them
# http://localhost:3000 (va domain that) vao "Authorized JavaScript origins" —
# KHONG can redirect URI vi luong nay chay hoan toan trong trinh duyet.
# De trong = an nut Google, chi con dang nhap bang mat khau.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=808022336710-1o61ua6vcdm4e7q8jnu6omf81mthbn48.apps.googleusercontent.com
